---
import { withBase } from '../utils/paths';
import '@fontsource-variable/onest';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/education.css';
import '../styles/project-media.css';
import '../styles/review-fixes.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = `${profile.name} — ${profile.role}`, description = 'Портфолио Максима: Lighthouse.by, сайт MARÉA и мобильное приложение на Flutter. Laravel, WordPress, MySQL.', noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <meta name="theme-color" content="#f8f9fc" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" /><meta property="og:locale" content="ru_RU" /><meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL(withBase('/og.png'), Astro.site)} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Максим — веб- и мобильный разработчик. Laravel, WordPress, Flutter." /></>}
    <script is:inline>
      (() => {
        let stored;
        try { stored = localStorage.getItem('portfolio-theme'); } catch {}
        const dark = stored === 'dark' || (stored !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <Header /><main id="main"><slot /></main><Footer />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
