---
import { withBase } from '../utils/paths';
import { education, courseCount } from '../data/education';
import Icon from './Icon.astro';
import PhotoCredits from './PhotoCredits.astro';
---
<section id="education" class="education-section" aria-labelledby="education-title">
  <div class="container">
    <div class="section-heading"><div><span class="eyebrow">Образование · {education.years}</span><h2 id="education-title">{education.specialty}</h2></div><a class="text-link" href={withBase('/education/')}>Программа обучения <Icon name="arrow" size={20} /></a></div>
    <div class="university-showcase">
      <div class="university-photos">
        <figure class="university-main-photo"><img src={withBase('/images/bsu/main.webp')} width="1440" height="758" alt="Главный корпус Белорусского государственного университета в Минске" loading="lazy" /><figcaption>Белорусский государственный университет · Минск</figcaption></figure>
        <figure class="university-secondary-photo"><img src={withBase('/images/bsu/campus.webp')} width="1000" height="590" alt="Университетский городок БГУ, вид сверху" loading="lazy" /></figure>
      </div>
      <div class="university-description">
        <span class="university-period">{education.years}<span>Выпускник БГУ</span></span>
        <h3>{education.university}</h3>
        <p>{education.faculty}</p>
        <p class="university-track">{education.track}</p>
        <a class="button" href={withBase('/education/')}>Все {courseCount} дисциплин <Icon name="arrow" size={19} /></a>
      </div>
    </div>
    <PhotoCredits />
  </div>
</section>
