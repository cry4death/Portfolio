---
import { withBase } from '../utils/paths';
import { skills } from '../data/profile';
import { skillIcons } from '../data/technologies';
import TechBadge from './TechBadge.astro';
import StudySkills from './StudySkills.astro';
const primaryNames = ['Backend', 'Frontend', 'Базы данных', 'Мобильная разработка'];
const primary = primaryNames.map((name) => skills.find((skill) => skill.label === name)!).filter(Boolean);
const additional = skills.filter((skill) => !primaryNames.includes(skill.label));
---
<section id="skills" class="section container skills-section" aria-labelledby="skills-title">
  <div class="section-heading"><h2 id="skills-title">Навыки и опыт</h2><p>Основные направления — веб-разработка и Flutter.</p></div>
  <div class="skills-grid skills-primary">{primary.map((skill) => <article class="skill-card"><div class="skill-card-heading"><span class="skill-category-icon" aria-hidden="true"><img src={withBase('/icons/' + skillIcons[skill.label] + '.svg')} width="25" height="25" alt="" loading="lazy" /></span><h3>{skill.label}</h3></div><div class="tags">{skill.items.map((name) => <TechBadge name={name} />)}</div></article>)}</div>
  <details class="more-skills"><summary><span><strong>Все инструменты и учебный опыт</strong><span>WordPress, тестирование, инфраструктура, .NET, Java и дизайн</span></span><span class="more-skills-symbol" aria-hidden="true">+</span></summary><div class="more-skills-content"><div class="skills-grid">{additional.map((skill) => <article class="skill-card"><div class="skill-card-heading"><span class="skill-category-icon" aria-hidden="true"><img src={withBase('/icons/' + skillIcons[skill.label] + '.svg')} width="25" height="25" alt="" loading="lazy" /></span><h3>{skill.label}</h3></div><p>{skill.description}</p><div class="tags">{skill.items.map((name) => <TechBadge name={name} />)}</div></article>)}</div><StudySkills /></div></details>
</section>
