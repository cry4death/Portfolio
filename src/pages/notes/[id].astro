---
import { withBase } from '../../utils/paths';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths() { return (await getCollection('notes')).map((note) => ({ params: { id: note.id }, props: { note } })); }
interface Props { note: CollectionEntry<'notes'>; }
const { note } = Astro.props;
const { Content } = await render(note);
---
<Layout title={`${note.data.title} — Максим`} description={note.data.description}><div class="container detail-page note-page"><a class="back-link" href={withBase('/#notes')}>← Все заметки</a><div class="detail-heading"><span class="eyebrow">{note.data.tag} · {note.data.minutes} мин чтения</span><h1>{note.data.title}</h1><p>{note.data.description}</p><time datetime={note.data.date.toISOString()}>{note.data.date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></div><article class="prose"><Content /></article><a class="text-link" href={withBase('/#notes')}>← Вернуться к заметкам</a></div></Layout>
